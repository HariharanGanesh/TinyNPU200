# Vivado Generated Caches & Temporary Directories
.Xil/
**/.Xil/
tinynpu200_ip_packager/tinynpu200_ip_packager.cache/
tinynpu200_ip_packager/tinynpu200_ip_packager.hw/
tinynpu200_ip_packager/tinynpu200_ip_packager.ip_user_files/
tinynpu200_ip_packager/tinynpu200_ip_packager.sim/

# Vivado Journals & Logs
*.jou
*.backup.jou
*.log
*.backup.log
vivado_*.backup.jou
vivado_*.backup.log

# Vivado PID / State Files
*.str

# Bitstreams (board-specific; user must build their own)
*.bit
*.bin
*.mcs

# Large Binary Archives (exceed GitHub 100 MB limit)
*.zip
*.tar.gz
*.7z
*.rar

# Timing & Debug Dumps
synth_warnings.txt
failed_path.txt
failed_path2.txt
failing_paths.txt
tight_setup_hold_pins.txt
dma_pins.txt
pin_dump.txt
all_pins_dump.txt
dfx_runtime.txt

# JVM / OS Crash Logs
hs_err_pid*.log

# Python Bytecode
__pycache__/
*.pyc

# OS / Editor Artifacts
Thumbs.db
.DS_Store
.vscode/
.idea/
*~

# =============================================================================
# INTENTIONALLY KEPT (NOT excluded):
# IP/TinyNPU200/src/*.v    ? RTL source files
# IP/TinyNPU200/sim/       ? Testbench files
# IP/TinyNPU200/component.xml
# tinynpu200_ip_packager/*.xpr
# *.xdc, run_all.tcl, run_simulation.bat
# =============================================================================
